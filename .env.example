# Local AI (free, runs on your machine): https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_NUM_CTX=16384
CONTENTFORGE_LANGUAGE=he

# Local speech-to-text (faster-whisper): tiny / base / small / medium / large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# WordPress (Settings > Users > Application Passwords)
WORDPRESS_URL=https://example.com
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facebook page / Instagram business account (Graph API)
META_PAGE_ID=
META_PAGE_TOKEN=
INSTAGRAM_USER_ID=

# YouTube: path to the OAuth client JSON from Google Cloud Console
YOUTUBE_CLIENT_SECRETS=client_secret.json

# Any other network (TikTok, X, LinkedIn...) through a self-hosted n8n workflow
WEBHOOK_URL=
